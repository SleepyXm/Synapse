DATABASE=
MIGRATION_DATABASE=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=
DEV_SERVER=http://localhost:3000
DEV_SERVER_BACKEND=http://localhost:8000
FRONTEND_PROD=
RESEND_API_KEY=
REDIS_URL=localhost:6379
KNOWLEDGE_SERVICE_URL=http://localhost:8090
KNOWLEDGE_SERVICE_TOKEN=replace-with-a-long-random-development-secret
KNOWLEDGE_DIR=var/knowledge
KNOWLEDGE_TOKENIZER_CACHE=var/tokenizers
KNOWLEDGE_ADDR=:8090
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=false
QDRANT_DENSE_COLLECTION=synapse_knowledge_dense_regions_v2
QDRANT_SPARSE_COLLECTION=synapse_knowledge_sparse_regions_v2
TEI_URL=http://localhost:8081
TEI_EMBEDDING_DIMENSION=384
TEI_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBED_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_REGION_MAX_TOKENS=128
KNOWLEDGE_PROCESSOR_URL=http://localhost:5001
KNOWLEDGE_INDEX_VERSION=v2
# Calibrated against backend/knowledge/testdata/retrieval.json. Recalibrate for a new index model.
KNOWLEDGE_DENSE_THRESHOLD=0.55
KNOWLEDGE_SPARSE_THRESHOLD=12.5
KNOWLEDGE_INGESTION_ATTEMPTS=3
KNOWLEDGE_MAX_UPLOAD_BYTES=104857600
KNOWLEDGE_STORAGE=local
# S3-compatible production storage (required when KNOWLEDGE_STORAGE=s3).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_TLS=true
