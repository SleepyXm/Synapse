# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local RAG corpus. Application code lives in backend/knowledge; private source
# documents live under backend/var and must never be committed.
/backend/var/knowledge/*
!/backend/var/knowledge/.gitkeep
/backend/var/tokenizers/
/backend/libtokenizers/
/backend/:memory:.ses
/:memory:.ses
